# ORIM server configuration. Copy to .env.local for development.
# Never commit real values. On Vercel, set these in Project Settings → Environment Variables.
# None of these use NEXT_PUBLIC_, so none reach the browser.

# Public address of the app, used in SMS links and to decide on secure cookies
APP_BASE_URL=http://localhost:3000

# One long random string (32+ characters). Keys for cookies, phone hashing and encryption are derived from it.
# Changing it signs everyone out and makes stored prize phone numbers unreadable.
ORIM_SECRET=replace_with_at_least_32_random_characters

# Postgres. Leave empty to use embedded Postgres stored in ORIM_DATA_DIR (default ./.orim-data).
# Serverless hosts such as Vercel need a real DATABASE_URL (e.g. Neon) with sslmode=require.
DATABASE_URL=
ORIM_DATA_DIR=

# Africa's Talking. Without an API key ORIM uses a mock provider that sends nothing.
# Sandbox: AT_USERNAME must be "sandbox". Production: your live app username.
AT_USERNAME=sandbox
AT_API_KEY=replace_with_sandbox_key
AT_SENDER_ID=
AT_ENVIRONMENT=sandbox
# Force a provider: africastalking | mock
AT_PROVIDER=

# Feature switches. Both default to off in every environment.
ENABLE_SMS_CHALLENGES=false
ENABLE_AIRTIME_PAYOUTS=false
# Second key required before any airtime is sent through the production API
AIRTIME_LIVE_APPROVED=false

# Guardrails
SMS_ALLOWED_COUNTRIES=KE
SMS_DAILY_LIMIT=200
AIRTIME_DAILY_LIMIT=2000

# Admin endpoints (/api/internal/*) take "Authorization: Bearer <ADMIN_TOKEN>". Unset = admin disabled.
ADMIN_TOKEN=
# Secret carried in Africa's Talking callback URLs (?token=...). Unset = callbacks disabled.
AT_WEBHOOK_SECRET=
