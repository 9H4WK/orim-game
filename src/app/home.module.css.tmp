/* ── Main Unified Interface Board ── */
.mainBoard {
  width: 100%;
  max-width: 900px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  animation: boardAppear 0.8s cubic-bezier(.17,.67,.44,1.27) forwards;
  /* Ensure it looks like ONE solid piece */
  margin-top: 20px;
}

@keyframes boardAppear {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

/* 1. Integrated Logo Section */
.integratedLogo {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 30px 0 15px;
}

.logoSub {
  font-family: var(--font-legendary);
  font-size: 14px;
  color: var(--color-gold);
  letter-spacing: 5px;
  text-transform: uppercase;
  opacity: 0.9;
}

/* 2. Board Divider (Visual Separation within single panel) */
.boardDivider {
  height: 4px;
  background: #111827;
  position: relative;
  margin: 0 -24px;
  box-shadow: 0 2px 0 rgba(255,255,255,0.05);
}

/* 3. Features Inside the Board */
.featuresInside {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 20px;
  padding: 10px 20px;
}

.featureCell {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 20px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.05);
  transition: all 0.2s ease;
}

.featureCell:hover {
  background: rgba(139, 92, 246, 0.05);
  border-color: rgba(139, 92, 246, 0.3);
}

.featureTitle {
  font-family: var(--font-legendary);
  font-size: 18px;
  color: #fff;
  margin-bottom: 4px;
}

.featureDesc {
  font-size: 13px;
  color: var(--color-text-dim);
  line-height: 1.4;
}

/* 4. Wallet / Play Inside the Board */
.walletInside {
  padding: 20px 0 40px;
}

.connectedArea, .connectArea {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 25px;
  width: 100%;
}

.walletHeader {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 24px;
  background: rgba(0,0,0,0.4);
  border: 2px solid rgba(255,255,255,0.05);
}

.primaryActions {
  display: flex;
  flex-direction: column;
  gap: 20px;
  width: 100%;
  max-width: 450px;
}

.subActions {
  display: flex;
  gap: 12px;
}

.subActions button {
  flex: 1;
}

.connectHint {
  font-family: var(--font-legendary);
  font-size: 18px;
  color: var(--color-gold);
  letter-spacing: 2px;
}
